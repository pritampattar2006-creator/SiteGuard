# Copy to .env and fill in. None of these are needed for local demos (safe defaults are used and a warning is printed).
SITEGUARD_SECRET=            # signs sign-in tokens; set a long random value for anything real
INGEST_KEY=                  # shared by the API and the detector service; the detector pushes cases with it
DEMO_MODE=1                  # 1 allows the demo-only employee list endpoint; set 0 for real use
VITE_AUTO_LOGIN=             # set to 1 only for a quick demo: each site signs itself in as a dummy account (no login page)
VITE_API_URL=                # where the sites find the API (default: this computer, port 4000)
VITE_DETECTOR_URL=           # where the sites find the detector service (default: this computer, port 5000)
DUMMY_NAMES=1                # detector service: 0 means only enrolled employees are ever named (no made-up names)
